#!/bin/bash -l
#$ -P batmanlab
#$ -l h_rt=24:00:00
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -pe omp 4
#$ -l mem_per_core=8G

set -euo pipefail

export TOKENIZERS_PARALLELISM=false
export NO_ALBUMENTATIONS_UPDATE=1
export OMP_NUM_THREADS="${NSLOTS:-4}"
export PYTHONDONTWRITEBYTECODE=1

module load miniconda
conda activate "${MAMMO_FM_CONDA_ENV:-Mammo-FM}"

nvidia-smi
python -c 'import torch; assert torch.cuda.is_available(), "CUDA is unavailable"; assert torch.cuda.device_count() >= 1, "No allocated GPU is visible"; print(f"CUDA preflight passed: {torch.cuda.get_device_name(0)}")'

: "${MAMMO_FM_REPO_ROOT:?Set MAMMO_FM_REPO_ROOT to the Mammo-FM repository root.}"
: "${MAMMO_FM_EVAL_DIR:?Set MAMMO_FM_EVAL_DIR to an output directory outside the repository.}"

echo "Running: $ARCH with checkpoint $CLIP_CKPT"
echo $ARCH
echo $DATASET_NAME
echo $DATA_DIR
echo $IMG_DIR
echo $CSV_FILE
echo $DATA_FRAC
echo $LABEL
echo $WEIGHTED_BCE

task_args=()
if [[ "${LABEL}" == "density" ]]; then
  task_args+=(--num-classes 4)
  if [[ "${DATASET_NAME,,}" == "lumina" ]]; then
    : "${LUMINA_DENSITY_METADATA:?Set the cohort-keyed LUMINA density CSV path}"
    task_args+=(--density-metadata "${LUMINA_DENSITY_METADATA}")
  fi
fi

python -u "${MAMMO_FM_REPO_ROOT}/src/codebase/train_classifier.py" \
  --tensorboard-path "${MAMMO_FM_EVAL_DIR}/tensorboard" \
  --checkpoints "${MAMMO_FM_EVAL_DIR}/checkpoints" \
  --output_path "${MAMMO_FM_EVAL_DIR}/outputs" \
  --data-dir "$DATA_DIR" \
  --img-dir "$IMG_DIR" \
  --csv-file "$CSV_FILE" \
  --data_frac "$DATA_FRAC" \
  --dataset "$DATASET_NAME" \
  --arch "$ARCH" \
  --clip_chk_pt_path "$CLIP_CKPT" \
  --epochs "${EPOCHS:-15}" \
  --img-size 1520 912 \
  --batch-size 8 \
  --num-workers 2 \
  --lr 5e-5 \
  --weight-decay 1e-4 \
  --warmup-epochs 1 \
  --print-freq 500 \
  --log-freq 500 \
  --running-interactive 'n' \
  --weighted-BCE "$WEIGHTED_BCE" \
  --balanced-dataloader 'n' \
  --label "$LABEL" --n_folds 1 "${task_args[@]}"
